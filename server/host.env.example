# Copy to server/host.env on the storage host. Never committed — it holds
# JWT_SECRET.

# The database and every uploaded photograph, together, permanently.
VAR_DIR=/home/dokutah/retinax-data

# The front end's URL, exactly, no trailing slash. CORS compares it character
# for character.
WEB_ORIGIN=https://retinax.pages.dev

# openssl rand -hex 32
JWT_SECRET=CHANGE_ME

# Generate another independent secret and set the SAME value in Cloudflare
# Pages (Settings -> Environment variables -> API_PROXY_SECRET). The Pages
# Function signs its forwarded client-IP header with this value, so direct
# callers cannot spoof their address to bypass IP rate limits.
# openssl rand -hex 32
API_PROXY_SECRET=CHANGE_ME_TOO

# The accounts that skip email confirmation and device approval, so anyone in
# the room can sign in to the demo. Comma separated. Leave unset for none.
DEMO_EMAILS=quang@retinax.ai

# --- rate limits ------------------------------------------------------------
# All 21 of them, with the defaults from server.js, because a limit you cannot
# find is a limit you cannot raise. node reads this file directly, so any name
# uncommented here takes effect on the next restart.
#
# The defaults assume one account per person. A shared demo account spends them
# all at once, so raise the ones a room full of people will hit before a
# presentation - sign-ins, uploads and chat above all.
#
# Per account:
# RATE_LOGIN_ACCOUNT_MAX=10        sign-ins per account per 15 min
# RATE_FORGOT_ACCOUNT_MAX=5        password-reset requests per account
# RATE_UPLOAD_PER_10_MIN=10        uploads per account per 10 min
# RATE_REGRADE_PER_10_MIN=6        re-grades per account per 10 min
# RATE_CAM_EXPLAIN_PER_10_MIN=12   Grad-CAM redraws per account per 10 min
# RATE_CCEM_EXPLAIN_PER_HOUR=4     CCEM runs per account per hour (each is minutes of GPU)
# RATE_CHAT_PER_MINUTE=12          chat messages per account per minute
# RATE_CHAT_PER_HOUR=120           chat messages per account per hour
#
# Per client IP - these are what a stranger hits, so they are deliberately
# looser per name and tighter in aggregate:
# RATE_LOGIN_IP_MAX=100
# RATE_SIGNUP_IP_MAX=20
# RATE_FORGOT_IP_MAX=50
# RATE_RESET_IP_MAX=30
# RATE_VERIFY_IP_MAX=120
# RATE_HEALTH_IP_MAX=120
#
# Concurrency - these protect the GPU, not the account. Raising them does not
# make anything faster; it makes everything slower at once.
# RATE_AI_USER_CONCURRENT=1        images grading at once per account
# RATE_AI_GLOBAL_CONCURRENT=4      images grading at once, whole system
# RATE_CHAT_USER_CONCURRENT=2      chat streams at once per account
# RATE_CHAT_GLOBAL_CONCURRENT=6    chat streams at once, whole system
#
# Token budgets for chat, which is metered by size as well as by count:
# RATE_CHAT_MAX_REQUEST_TOKENS=4000
# RATE_CHAT_TOKEN_BUDGET_10_MIN=16000
# RATE_CHAT_TOKEN_BUDGET_HOUR=64000

# --- reaching the model -----------------------------------------------------
# /infer has no authentication of its own, so it must not be on the open
# internet. Two private routes; pick whichever the machines allow.
#
# (a) SSH tunnel — needs NOTHING installed on the GPU host, so this is the one
#     to use when you do not have root there. The script opens it for you.
AI_SSH=hungntt@spark.example.com
AI_SSH_PORT=8000
AI_URL=http://localhost:8000
#
# (b) Tailscale — if the GPU host can join the tailnet instead:
# AI_URL=http://spark-063e:8000

# --- the one public hostname ------------------------------------------------
# The tunnel in front of the API. Nothing in run-on-host.sh starts it; this is
# read only by `status`, so the check can reach the API the way a browser does.
#
# cloudflared quick tunnel (what this deployment uses):
#     tmux new -d -s cftunnel 'cloudflared tunnel --url http://localhost:3000'
#     tmux capture-pane -pt cftunnel | grep trycloudflare
# It prints a NEW hostname every time it starts, so this value and API_ORIGIN
# in Cloudflare Pages both have to be updated, and the deployment retried.
PUBLIC_URL=https://<the-tunnel-hostname>

# Older form, for a reserved ngrok domain. run-on-host.sh still launches ngrok
# when this is set, and prefers PUBLIC_URL for the status check.
# NGROK_DOMAIN=example.ngrok-free.dev

# --- email --------------------------------------------------------------------
# Used for three things: confirming a new address, approving a sign-in from an
# unknown browser, and password reset. Without them every link is written to the
# server log instead, and the sign-in screen says so rather than promising an
# email that will never arrive.
#
# mail.js speaks to the Gmail API with OAuth2 and nothing else - there is no
# SMTP path and no Resend path, whatever older copies of this file suggested.
# GMAIL_CLIENT_ID=...apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=          # revoke the old grant before issuing a new one
# GMAIL_USER=you@gmail.com      # the mailbox that sends
# MAIL_FROM=RetinaX.ai <you@gmail.com>    # defaults to GMAIL_USER

# --- the assistant ------------------------------------------------------------
# The app-wide assistant talks to ollama on the GPU host through the local
# proxy in tools/ollama-proxy.py, which rewrites the Host header because ollama
# refuses anything that is not localhost. Ollama has no authentication of its
# own: it must never be reachable from the internet.
# OLLAMA_URL=http://127.0.0.1:11500
# CHAT_MODEL=qwen3.5:4b         # must match `ollama list` on the GPU host exactly
# CHAT_NUM_PREDICT=900          # a ceiling, not an instruction to be brief
# CHAT_TIMEOUT_MS=120000

# --- limits and timeouts ------------------------------------------------------
# MAX_UPLOAD_MB=12              # a larger photograph is refused with 413
# KEEP_ALIVE_MS=65000           # must stay above any client's idle gap
# AI_TIMEOUT_MS=45000           # one grading call, including model load
# AI_CCEM_TIMEOUT_MS=600000     # CCEM fuses three explainers; it is minutes
# AI_CHAT_TIMEOUT_MS=90000      # ollama loading a model after idling is slow

# --- seeding ------------------------------------------------------------------
# run-on-host.sh passes SEED_DEMO=1 on the command line, so a value here is
# overridden. Set SEED_CCEM=1 only if the demo needs precomputed CCEM overlays -
# generating them is minutes of GPU per image.
# SEED_CCEM=0

# --- storage layout -----------------------------------------------------------
# Both default to subdirectories of VAR_DIR and almost never need setting. They
# exist for a deployment that must split the database from the photographs.
# DATA_DIR=/home/dokutah/retinax-data/data
# UPLOAD_DIR=/home/dokutah/retinax-data/uploads
