PORT=3000
JWT_SECRET=change-this-to-a-long-random-string
AI_URL=http://127.0.0.1:8000
WEB_ORIGIN=http://localhost:5173

# In production, set the SAME long random value on:
#   1) the API host, and
#   2) Cloudflare Pages as API_PROXY_SECRET.
# The Pages Function uses it to forward the real Cloudflare client IP without
# letting a caller spoof x-retinax-client-ip by talking directly to the tunnel.
API_PROXY_SECRET=

# Optional rate-limit tuning. Defaults are safe for the single-process demo.
# RATE_LOGIN_IP_MAX=100
# RATE_LOGIN_ACCOUNT_MAX=10
# RATE_SIGNUP_IP_MAX=20
# RATE_FORGOT_IP_MAX=50
# RATE_FORGOT_ACCOUNT_MAX=5
# RATE_RESET_IP_MAX=30
# RATE_CHAT_PER_MINUTE=12
# RATE_CHAT_PER_HOUR=120
# RATE_CHAT_MAX_REQUEST_TOKENS=4000
# RATE_CHAT_TOKEN_BUDGET_10_MIN=16000
# RATE_CHAT_TOKEN_BUDGET_HOUR=64000
# RATE_CHAT_USER_CONCURRENT=2
# RATE_CHAT_GLOBAL_CONCURRENT=6
# RATE_AI_USER_CONCURRENT=1
# RATE_AI_GLOBAL_CONCURRENT=4
# RATE_UPLOAD_PER_10_MIN=10
# RATE_REGRADE_PER_10_MIN=6
# RATE_CAM_EXPLAIN_PER_10_MIN=12
# RATE_CCEM_EXPLAIN_PER_HOUR=4
# RATE_HEALTH_IP_MAX=120
