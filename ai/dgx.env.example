# Copy to ai/dgx.env on the DGX Spark and correct the paths.
# Never commit the real dgx.env — it is gitignored, and it holds JWT_SECRET.

# ---- the model -------------------------------------------------------------
DR_REPO=/home/hungntt/Projects/USTH/ProjectDR2026
MODEL_PATH=/home/hungntt/Projects/USTH/ProjectDR2026/src/experiments/Stage2_Finetune_B7_CBAM/stage2_best_model.pth
THRESHOLD_PATH=/home/hungntt/Projects/USTH/ProjectDR2026/src/experiments/Stage2_Finetune_B7_CBAM/best_thresholds.npy

# Grad-CAM++ only on upload. CCEM fuses three explainers and is far too slow
# for a live request — it belongs in the precompute batch.
CCEM_ON_UPLOAD=0

# How the explanation map is painted.
#   jet    the palette used in the paper's figures: deep blue through cyan and
#          green to yellow and red, covering the whole retina. The doctor's
#          opacity control is what lets the photograph back through.
#   green  transparent below HEATMAP_FLOOR, green rising to the peak. Shows more
#          of the photograph, at the cost of matching the figures.
HEATMAP_STYLE=jet

# 'jet' only: how much heatmap versus photograph goes into the blend. Higher
# makes the activation louder and the retina harder to read; the paper's
# figures are about 0.5.
# HEATMAP_BLEND=0.45
# HEATMAP_FLOOR=0.35        # 'green' only
# HEATMAP_MAX_ALPHA=0.85    # 'green' only

# ---- the tunnel ------------------------------------------------------------
# TUNNEL=0 when the API reaches this service over Tailscale rather than the
# public internet. Prefer this: /infer has no authentication of its own, so a
# public URL for it is an open endpoint anyone who learns the hostname can use.
# The API host then sets AI_URL=http://<this-machine>:8000 on the tailnet.
TUNNEL=0

# Only used when TUNNEL=1. A reserved ngrok domain, so the public hostname
# survives every restart of this machine.
# NGROK_DOMAIN=acuteness-finless-pluck.ngrok-free.dev

# ---- the API, running here too ---------------------------------------------
# This is what makes the data permanent: this machine has a real disk and does
# not sleep, unlike a free web host whose filesystem is wiped on every deploy,
# restart and spin-down.
#
# With SERVE_API=1 the tunnel fronts the API rather than the model — the API
# reaches the model over localhost, so one tunnel serves the whole backend.
# Leave this 0 when a separate storage host runs the API — which is the
# arrangement that keeps the site alive when this shared machine is not.
SERVE_API=0
API_PORT=3000

# The database and every uploaded photograph live here, together, forever.
VAR_DIR=/home/hungntt/retinax-data

# Must match the front end's URL character for character, or CORS rejects
# every request. No trailing slash.
WEB_ORIGIN=https://retinax.pages.dev

# Generate once:  openssl rand -hex 32
# Changing it signs everyone out; it does not corrupt anything.
JWT_SECRET=CHANGE_ME

# --- the model itself ---------------------------------------------------------
# Every value here has a default in the code, and the defaults ARE the deployed
# configuration - they are written out because on 29 Sep 2026 this file was
# destroyed by an `rm -rf` and every one of them had to be reconstructed by
# reading /health against dr_adapter.py. Documented, that recovery is a copy.
#
# Changing any of them changes the grade the model produces. Read
# docs/OPTIMIZATION-BASELINE.md first: a change that moves a grade is a
# regression, not a tuning.
MODEL_NAME=tf_efficientnet_b7_ns
IMAGE_SIZE=600
USE_CBAM=1
# Test-time augmentation: the original plus a horizontal and a vertical flip,
# averaged. Turning it off is the easiest speed-up available and it CHANGES
# GRADES, so it is not a speed-up you may take. The spread across the three
# views is also the cheapest uncertainty estimate the system has (confidence.py).
USE_TTA=1
# channels_last memory layout. Off by default because it can move the last
# digits of a score, and this file's rule is that anything which can move a
# score must be measured before it ships.
USE_CHANNELS_LAST=0
# Set to 1 only to prove something on a machine with no GPU. Grading on CPU is
# minutes per image.
FORCE_CPU=0

# --- the fundus gate ----------------------------------------------------------
# CLIP decides whether the upload is a retinal photograph at all, before the
# grading model is allowed an opinion about it.
FUNDUS_ACCEPT_THRESHOLD=0.70
FUNDUS_REJECT_THRESHOLD=0.30

# --- lesion models ------------------------------------------------------------
# Six .pth files plus their .json metrics. The metrics decide which classes the
# UI is allowed to present as findings and which are marked provisional.
LESION_WEIGHTS=/home/hungntt/lesion-weights

# --- the per-case assistant ---------------------------------------------------
# A ceiling on the answer, not an instruction to be brief - num_predict cuts
# mid-sentence when it runs out. Ask for brevity in the system prompt instead.
CHAT_NUM_PREDICT=700
# How much of a clinician's note is quoted into the conversation. It is quoted
# as data between fence markers, never as instruction.
CHAT_NOTE_LIMIT=1500
